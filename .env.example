# Externally reachable URL of the bridge; claude.ai gets <PUBLIC_URL>/mcp.
PUBLIC_URL=http://localhost:3000
PORT=3000
# Set to true behind an ingress / reverse proxy.
TRUST_PROXY=false

# Infomaniak OAuth application (identity only). Its redirect URIs must include
# <PUBLIC_URL>/auth/infomaniak/callback.
INFOMANIAK_CLIENT_ID=
INFOMANIAK_CLIENT_SECRET=

# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts stored API tokens.
BRIDGE_ENCRYPTION_KEY=

# sqlite (default, local/dev) or redis (production; REDIS_URL, not implemented yet)
STORE=sqlite
SQLITE_PATH=./data/bridge.sqlite
#REDIS_URL=redis://localhost:6379

# Which Infomaniak products to expose (comma-separated): mail, calendar
ENABLED_SERVICES=mail,calendar
# Optional: only these email domains may sign in (in addition to the app's org restriction)
#ALLOWED_EMAIL_DOMAINS=domain.com

# Upstream server processes: idle seconds before stopping one, max per replica
PROCESS_IDLE_TTL=600
MAX_PROCESSES=100

ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000
