# Externally reachable URL of the bridge; claude.ai gets <PUBLIC_URL>/mcp.
PUBLIC_URL=http://localhost:3000
PORT=3000
# Behind an ingress / reverse proxy: number of proxy hops that set X-Forwarded-* (true = 1, e.g.
# Traefik alone; 2 if an L7 load balancer in front of Traefik also appends X-Forwarded-For), or a
# comma list of CIDRs. Needed for per-client rate limits; the bridge warns if PUBLIC_URL is https
# and this is false. The Docker image defaults it to true.
TRUST_PROXY=false

# Infomaniak OAuth application (identity only). Its redirect URIs must include
# <PUBLIC_URL>/auth/infomaniak/callback.
INFOMANIAK_CLIENT_ID=
INFOMANIAK_CLIENT_SECRET=

# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts stored API tokens.
BRIDGE_ENCRYPTION_KEY=

# sqlite (default: one replica, local file) or redis (shared by replicas; the k8s example uses it)
STORE=sqlite
SQLITE_PATH=./data/bridge.sqlite
#REDIS_URL=redis://:password@localhost:6379/0

# Which Infomaniak products to expose (comma-separated): mail, calendar, contact, kchat, kdrive
ENABLED_SERVICES=mail,calendar
# kchat needs the team (subdomain of https://<team>.kchat.infomaniak.com), kdrive the drive id
# (https://ksuite.infomaniak.com/all/kdrive/app/drive/<id>): one team / one drive per deployment.
#KCHAT_TEAM_NAME=
#KDRIVE_ID=
# Optional: only these email domains may sign in (in addition to the app's org restriction)
#ALLOWED_EMAIL_DOMAINS=domain.com

# Upstream server processes: idle seconds before stopping one, max per replica
# (each is a full Node process; size MAX_PROCESSES to the memory you give the bridge)
PROCESS_IDLE_TTL=600
MAX_PROCESSES=20

ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000
# Dynamically registered OAuth clients are dropped after this long without issuing tokens
# (never below REFRESH_TOKEN_TTL, so a live refresh token always keeps its client)
CLIENT_TTL=7776000
